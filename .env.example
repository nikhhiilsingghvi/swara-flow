# SwaraFlow environment configuration
# Copy this file to .env and edit as needed. Every value here has a
# sensible default in backend/core/config.py -- you only need to set
# what you want to change.

# --- Paths -----------------------------------------------------------------
SF_DATA_DIR=./data
SF_CONFIGS_DIR=./configs

# --- Audio -------------------------------------------------------------------
SF_SAMPLE_RATE_HZ=44100
SF_FRAME_SIZE=2048
SF_HOP_SIZE=512
SF_FMIN_HZ=70
SF_FMAX_HZ=1000
SF_YIN_THRESHOLD=0.12
SF_SILENCE_RMS=0.01
SF_MIN_VOICED_CONF=0.5

# --- Swara mapping ---------------------------------------------------------
SF_MAX_SNAP_CENTS=60
SF_STABILITY_WINDOW_CENTS=35
SF_STABILITY_MIN_MS=150

# --- Vision ------------------------------------------------------------------
SF_TARGET_FPS=24
SF_PROCESS_EVERY_NTH_FRAME=2
SF_MAX_FRAME_WIDTH=640
SF_FACE_DETECTOR_CONF=0.5
SF_MOTION_HISTORY_FRAMES=15

# MediaPipe model paths (see scripts/download_models.*). Leave unset to
# run with pose/hand tracking in "unavailable" degraded mode.
SF_POSE_MODEL_PATH=
SF_HAND_MODEL_PATH=
SF_FACE_MODEL_PATH=

# --- Sync --------------------------------------------------------------------
SF_SYNC_TOLERANCE_MS=40

# --- LLM (all optional -- app fully functions with SF_LLM_PROVIDER=none) ---
# One of: none, lmstudio, ollama, openai_compatible
SF_LLM_PROVIDER=none
SF_LMSTUDIO_BASE_URL=http://localhost:1234/v1
SF_OLLAMA_BASE_URL=http://localhost:11434
SF_OLLAMA_MODEL=llama3.1
SF_OPENAI_COMPAT_BASE_URL=
SF_OPENAI_COMPAT_API_KEY=
SF_OPENAI_COMPAT_MODEL=
SF_LLM_TIMEOUT_S=15

# --- Privacy / telemetry -----------------------------------------------------
# No telemetry is sent regardless of this flag in the current codebase;
# this exists as an explicit, auditable off-switch for any future
# opt-in analytics (see docs/privacy.md).
SF_TELEMETRY_ENABLED=false

# --- Networking ----------------------------------------------------------------
SF_CORS_ORIGINS=http://localhost:3000

# --- Logging -----------------------------------------------------------------
SF_LOG_LEVEL=INFO
